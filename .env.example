# Django Settings
DJANGO_SETTINGS_MODULE=project.settings
SECRET_KEY=generate-a-long-random-value-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Public URL of this deployment (used to build the Gmail OAuth redirect URI
# and to allow itself in CORS/CSRF when calling its own API).
SERVER_URL=http://localhost:8000

# Extra CORS/CSRF origins (comma-separated), if the frontend is hosted
# separately from the backend. Not needed when the backend serves the
# frontend itself (same-origin).
CORS_ALLOWED_ORIGINS=

# Database — leave unset to use local SQLite. Set to a Postgres connection
# string (e.g. from Neon) in production:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# Set to False only for a Postgres host that doesn't support/require SSL
# (e.g. a local Postgres container). Neon requires True (the default).
DATABASE_SSL_REQUIRE=True

# Shared secret for POST /internal/run-sequences/, which triggers the
# send_campaign_sequences management command over HTTP (used by a scheduled
# GitHub Actions workflow since Render's free tier has no free cron jobs).
# Leave unset to disable the endpoint entirely.
CRON_SECRET=

# OpenAI (required for lead search / email generation)
OPENAI_API_KEY=sk-your-openai-key

# Gmail SMTP fallback (optional — only used if Gmail OAuth isn't configured)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google OAuth2 — per-user Gmail sending (optional; leave blank to disable)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback/
